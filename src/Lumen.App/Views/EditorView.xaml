<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Lumen.App.Views.EditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Lumen.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Lumen.App.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Lumen.App.ViewModels"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        Background="Transparent"
        DragLeave="OnRootDragLeave"
        DragOver="OnRootDragOver"
        Drop="OnRootDrop"
        KeyUp="OnRootKeyUp"
        PreviewKeyDown="OnRootPreviewKeyDown"
        x:DefaultBindMode="OneWay">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="O"
                Invoked="OnOpenAccelerator"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Number0"
                Invoked="OnFitAccelerator"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Add"
                Invoked="OnZoomInAccelerator"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="Subtract"
                Invoked="OnZoomOutAccelerator"
                Modifiers="Control" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!--  ═══════════════ 工具栏（56 DIP）  ═══════════════  -->
        <Grid
            Grid.Row="0"
            Padding="16,0"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    AutomationProperties.AutomationId="BtnAddImages"
                    AutomationProperties.Name="添加图片"
                    Command="{x:Bind Vm.AddImagesCommand}"
                    IsEnabled="{x:Bind Vm.CanAdd}"
                    ToolTipService.ToolTip="添加图片（可多选，Ctrl+O）">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                        <TextBlock Text="添加图片" />
                    </StackPanel>
                </Button>

                <Button
                    AutomationProperties.AutomationId="BtnAddFolder"
                    AutomationProperties.Name="添加文件夹"
                    Command="{x:Bind Vm.AddFolderCommand}"
                    IsEnabled="{x:Bind Vm.CanAdd}"
                    ToolTipService.ToolTip="添加文件夹（递归扫描图片）">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                        <TextBlock Text="添加文件夹" />
                    </StackPanel>
                </Button>

                <Button
                    AutomationProperties.AutomationId="BtnClearQueue"
                    AutomationProperties.Name="清空队列"
                    Command="{x:Bind Vm.ClearQueueCommand}"
                    Content="清空队列"
                    IsEnabled="{x:Bind Vm.CanClearQueue}" />

                <Border
                    Width="1"
                    Height="20"
                    Margin="8,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Button
                    MinWidth="140"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="BtnStartAll"
                    AutomationProperties.Name="{x:Bind Vm.StartButtonText}"
                    Command="{x:Bind Vm.StartAllCommand}"
                    Content="{x:Bind Vm.StartButtonText}"
                    IsEnabled="{x:Bind Vm.CanStartOrCancel}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    Padding="10,4"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ToolTipService.ToolTip="当前处理模式">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE770;" />
                        <TextBlock
                            AutomationProperties.AutomationId="TxtComputeModeChip"
                            AutomationProperties.Name="当前处理模式"
                            FontSize="12"
                            Text="{x:Bind Vm.ComputeModeLabel}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!--  ═══════════════ 内容区：队列 + 画布 + 参数面板  ═══════════════  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  左侧队列面板  -->
            <Grid
                x:Name="QueuePanel"
                Grid.Column="0"
                Width="{x:Bind helpers:Ui.QueuePanelWidth(Vm.IsQueueCollapsed)}"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">

                <!--  展开态  -->
                <Grid Visibility="{x:Bind helpers:Ui.VisibleWhenFalse(Vm.IsQueueCollapsed)}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,10,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="队列" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind Vm.QueueCount}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Width="28"
                            Height="28"
                            Padding="0"
                            AutomationProperties.AutomationId="BtnCollapseQueue"
                            AutomationProperties.Name="折叠队列面板"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind Vm.ToggleQueuePanelCommand}"
                            ToolTipService.ToolTip="折叠队列面板">
                            <FontIcon FontSize="12" Glyph="&#xE76B;" />
                        </Button>
                    </Grid>

                    <ListView
                        x:Name="QueueList"
                        Grid.Row="1"
                        Padding="0,2,0,8"
                        AutomationProperties.AutomationId="QueueList"
                        AutomationProperties.Name="批处理队列"
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind Vm.Queue}"
                        SelectedItem="{x:Bind Vm.SelectedQueueItem}"
                        SelectionChanged="OnQueueSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueueItem">
                                <Grid
                                    Padding="12,6"
                                    AutomationProperties.HelpText="{x:Bind ErrorMessage, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                    ColumnSpacing="8"
                                    ToolTipService.ToolTip="{x:Bind ErrorMessage, Mode=OneWay}">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                AutomationProperties.Name="重新处理"
                                                Command="{x:Bind ReprocessCommand}"
                                                Text="重新处理" />
                                            <MenuFlyoutItem
                                                AutomationProperties.Name="移除"
                                                Command="{x:Bind RemoveCommand}"
                                                Text="移除" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                AutomationProperties.Name="打开输出文件"
                                                Command="{x:Bind OpenOutputCommand}"
                                                IsEnabled="{x:Bind HasOutput}"
                                                Text="打开输出文件" />
                                            <MenuFlyoutItem
                                                AutomationProperties.Name="在文件夹中显示"
                                                Command="{x:Bind RevealOutputCommand}"
                                                IsEnabled="{x:Bind HasOutput}"
                                                Text="在文件夹中显示" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid
                                        Width="48"
                                        Height="48"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        CornerRadius="4">
                                        <FontIcon
                                            FontSize="16"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE91B;" />
                                        <Image
                                            Source="{x:Bind Thumbnail, Mode=OneWay}"
                                            Stretch="UniformToFill" />
                                    </Grid>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock
                                            FontSize="14"
                                            Text="{x:Bind FileName}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind StatusLine, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind helpers:Ui.VisibleWhenFalse(IsFailed), Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind StatusLine, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind helpers:Ui.Visible(IsFailed), Mode=OneWay}" />
                                        <ProgressBar
                                            Height="3"
                                            Margin="0,2,0,0"
                                            Maximum="100"
                                            Value="{x:Bind Progress, Mode=OneWay}"
                                            Visibility="{x:Bind helpers:Ui.Visible(IsProcessing), Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border
                        Grid.Row="2"
                        Padding="12,8"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <TextBlock
                            AutomationProperties.AutomationId="TxtQueueSummary"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Vm.QueueSummary}"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <!--  折叠态：只留一条图标栏  -->
                <StackPanel
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Spacing="8"
                    Visibility="{x:Bind helpers:Ui.Visible(Vm.IsQueueCollapsed)}">
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="BtnExpandQueue"
                        AutomationProperties.Name="展开队列面板"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind Vm.ToggleQueuePanelCommand}"
                        ToolTipService.ToolTip="展开队列面板">
                        <FontIcon FontSize="12" Glyph="&#xE76C;" />
                    </Button>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Vm.QueueCount}" />
                </StackPanel>
            </Grid>

            <!--  中央画布  -->
            <Grid x:Name="CanvasArea" Grid.Column="1" Background="Transparent">
                <controls:CompareViewer
                    x:Name="Viewer"
                    AutomationProperties.AutomationId="CanvasViewer"
                    AutomationProperties.Name="图片画布（Ctrl+滚轮缩放，空格临时查看原图）"
                    IsCompareMode="{x:Bind Vm.IsCompareMode}"
                    IsTabStop="True"
                    OriginalSource="{x:Bind Vm.OriginalImage}"
                    PixelHeight="{x:Bind Vm.ImagePixelHeight}"
                    PixelWidth="{x:Bind Vm.ImagePixelWidth}"
                    ResultSource="{x:Bind Vm.ResultImage}"
                    UseSystemFocusVisuals="True"
                    Zoom="{x:Bind Vm.Zoom, Mode=TwoWay}" />

                <!--  空队列状态  -->
                <Grid
                    Background="Transparent"
                    Visibility="{x:Bind helpers:Ui.Visible(Vm.IsEmptyState)}">
                    <Button
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="BtnEmptyOpen"
                        AutomationProperties.Name="添加图片（空状态）"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind Vm.AddImagesCommand}">
                        <Grid Width="440" Height="230">
                            <Rectangle
                                Fill="Transparent"
                                RadiusX="8"
                                RadiusY="8"
                                Stroke="{ThemeResource ControlStrokeColorSecondaryBrush}"
                                StrokeDashArray="4,4"
                                StrokeThickness="1" />

                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontSize="28"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE91B;" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    Text="将插画或动漫截图拖到这里，或点击添加" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="PNG / JPEG / WebP / BMP · 支持多选与文件夹" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="Ctrl+O" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>

                <!--  选中项预览加载中  -->
                <ProgressRing
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind Vm.IsLoadingPreview}"
                    Visibility="{x:Bind helpers:Ui.Visible(Vm.IsLoadingPreview)}" />

                <!--  InfoBar：一次只显示一条  -->
                <InfoBar
                    x:Name="CanvasInfoBar"
                    Margin="16,16,16,0"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="InfoBarStatus"
                    AutomationProperties.Name="状态提示"
                    IsClosable="True"
                    IsOpen="{x:Bind Vm.IsInfoBarOpen, Mode=TwoWay}"
                    Message="{x:Bind Vm.InfoBarMessage}"
                    Severity="{x:Bind Vm.InfoBarSeverityValue}"
                    Title="{x:Bind Vm.InfoBarTitle}">
                    <InfoBar.ActionButton>
                        <Button
                            Command="{x:Bind Vm.OpenOutputFolderCommand}"
                            Content="打开输出文件夹"
                            Visibility="{x:Bind helpers:Ui.Visible(Vm.CanOpenOutputFolder)}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!--  批量处理中：画布顶部居中的非模态进度  -->
                <Border
                    Margin="0,16,0,0"
                    Padding="16,12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{ThemeResource ControlSolidFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind helpers:Ui.Visible(Vm.IsProcessing)}">
                    <StackPanel MinWidth="320" Spacing="8">
                        <ProgressBar
                            AutomationProperties.AutomationId="ProgressBarOverlay"
                            AutomationProperties.Name="当前项进度"
                            Maximum="100"
                            Value="{x:Bind Vm.ProgressValue}" />
                        <TextBlock
                            AutomationProperties.AutomationId="TxtBatchProgress"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Vm.BatchProgressText}" />
                    </StackPanel>
                </Border>

                <!--  画布右下角浮动工具条  -->
                <Border
                    Margin="16"
                    Padding="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource ControlSolidFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind helpers:Ui.Visible(Vm.HasImage)}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.AutomationId="BtnZoomOut"
                            AutomationProperties.Name="缩小"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind Vm.ZoomOutCommand}"
                            ToolTipService.ToolTip="缩小">
                            <FontIcon FontSize="14" Glyph="&#xE71F;" />
                        </Button>
                        <TextBlock
                            MinWidth="48"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{x:Bind Vm.ZoomText}"
                            TextAlignment="Center" />
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.AutomationId="BtnZoomIn"
                            AutomationProperties.Name="放大"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind Vm.ZoomInCommand}"
                            ToolTipService.ToolTip="放大">
                            <FontIcon FontSize="14" Glyph="&#xE8A3;" />
                        </Button>
                        <Button
                            Padding="8,4"
                            AutomationProperties.AutomationId="BtnFitCanvas"
                            AutomationProperties.Name="适应窗口（画布）"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind Vm.FitCommand}"
                            Content="适应窗口"
                            FontSize="12" />
                        <ToggleButton
                            x:Name="CompareToggle"
                            Padding="8,4"
                            AutomationProperties.AutomationId="BtnCompare"
                            AutomationProperties.Name="对比模式"
                            Background="Transparent"
                            BorderThickness="0"
                            Checked="OnCompareToggleChecked"
                            Content="对比"
                            FontSize="12"
                            IsChecked="{x:Bind Vm.IsCompareMode}"
                            IsEnabled="{x:Bind Vm.HasResult}"
                            Unchecked="OnCompareToggleUnchecked" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  右侧参数面板（可折叠）  -->
            <Grid
                x:Name="ParametersPanel"
                Grid.Column="2"
                Width="{x:Bind helpers:Ui.PanelWidth(Vm.IsPanelExpanded)}"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">

                <!--  展开态  -->
                <Grid Visibility="{x:Bind helpers:Ui.Visible(Vm.IsPanelExpanded)}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="16,10,12,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="参数" />
                        <Button
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.AutomationId="BtnCollapsePanel"
                            AutomationProperties.Name="折叠参数面板"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind Vm.TogglePanelCommand}"
                            ToolTipService.ToolTip="折叠参数面板">
                            <FontIcon FontSize="12" Glyph="&#xE76C;" />
                        </Button>
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        Padding="16,0,16,8"
                        IsEnabled="{x:Bind Vm.IsPanelEnabled}"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">

                            <!--  处理模式  -->
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="处理模式" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="CmbComputeMode"
                                    AutomationProperties.Name="处理模式"
                                    SelectedIndex="{x:Bind Vm.ComputeModeIndex, Mode=TwoWay}">
                                    <x:String>自动（推荐）</x:String>
                                    <x:String>GPU（DirectML）</x:String>
                                    <x:String>CPU 兼容（较慢）</x:String>
                                </ComboBox>
                                <TextBlock
                                    AutomationProperties.AutomationId="TxtComputeModeHint"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Vm.ComputeModeDescription}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind Vm.DeviceSummary}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!--  模型  -->
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="模型" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.AutomationId="CmbModel"
                                    AutomationProperties.Name="模型"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{x:Bind Vm.Models}"
                                    SelectedIndex="{x:Bind Vm.SelectedModelIndex, Mode=TwoWay}"
                                    ToolTipService.ToolTip="选择动漫超分模型" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Vm.ModelDescription}"
                                    TextWrapping="Wrap" />
                                <Border
                                    Padding="8,2"
                                    HorizontalAlignment="Left"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Vm.ModelTierLabel}" />
                                </Border>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="想用更多模型？把 ONNX 与 model.json 放进 models 文件夹后重启应用即可。" />
                                <HyperlinkButton
                                    Padding="0"
                                    AutomationProperties.AutomationId="BtnOpenModelsFolder"
                                    AutomationProperties.Name="打开模型目录"
                                    Content="打开模型目录"
                                    Command="{x:Bind Vm.OpenModelsFolderCommand}" />
                            </StackPanel>

                            <!--  倍率  -->
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="倍率" />
                                <RadioButtons
                                    AutomationProperties.AutomationId="RadioScale"
                                    AutomationProperties.Name="输出倍率"
                                    MaxColumns="3"
                                    SelectedIndex="{x:Bind Vm.ScaleIndex, Mode=TwoWay}">
                                    <RadioButtons.Resources>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="MinWidth" Value="0" />
                                        </Style>
                                    </RadioButtons.Resources>
                                    <x:String>2×</x:String>
                                    <x:String>3×</x:String>
                                    <x:String>4×</x:String>
                                </RadioButtons>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Vm.ScaleNoteText}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind helpers:Ui.Visible(Vm.ShowScaleNote)}" />
                            </StackPanel>

                            <!--  批量输出  -->
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="批量输出" />
                                <RadioButtons
                                    AutomationProperties.AutomationId="RadioOutputDirectory"
                                    AutomationProperties.Name="输出目录模式"
                                    SelectedIndex="{x:Bind Vm.OutputDirectoryModeIndex, Mode=TwoWay}">
                                    <RadioButtons.Resources>
                                        <Style TargetType="RadioButton">
                                            <Setter Property="MinWidth" Value="0" />
                                        </Style>
                                    </RadioButtons.Resources>
                                    <x:String>源文件所在目录</x:String>
                                    <x:String>自定义目录</x:String>
                                </RadioButtons>

                                <TextBlock
                                    AutomationProperties.AutomationId="TxtOutputDirectory"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Vm.OutputDirectoryDisplay}"
                                    TextWrapping="Wrap"
                                    ToolTipService.ToolTip="{x:Bind Vm.OutputDirectoryDisplay}" />
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind helpers:Ui.Visible(Vm.UseCustomOutputDirectory)}">
                                    <Button
                                        AutomationProperties.AutomationId="BtnPickOutputDir"
                                        AutomationProperties.Name="选择输出目录"
                                        Command="{x:Bind Vm.BrowseOutputDirectoryCommand}"
                                        Content="选择文件夹…"
                                        FontSize="12" />
                                    <Button
                                        AutomationProperties.AutomationId="BtnClearOutputDir"
                                        AutomationProperties.Name="清除自定义输出目录"
                                        Command="{x:Bind Vm.ClearOutputDirectoryCommand}"
                                        Content="恢复为源目录"
                                        FontSize="12" />
                                </StackPanel>

                                <TextBox
                                    AutomationProperties.AutomationId="TxtFileNamePattern"
                                    AutomationProperties.Name="文件名规则"
                                    Header="文件名规则"
                                    Text="{x:Bind Vm.FileNamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="可用：{name} {ext} {scale} {model} {index} {date}"
                                    TextWrapping="Wrap" />

                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="CmbConflictPolicy"
                                    AutomationProperties.Name="冲突策略"
                                    Header="冲突策略"
                                    SelectedIndex="{x:Bind Vm.ConflictPolicyIndex, Mode=TwoWay}">
                                    <x:String>自动重命名</x:String>
                                    <x:String>覆盖</x:String>
                                    <x:String>跳过</x:String>
                                </ComboBox>

                                <ToggleSwitch
                                    AutomationProperties.AutomationId="ToggleOpenOutputFolder"
                                    AutomationProperties.Name="完成后打开输出文件夹"
                                    Header="完成后打开输出文件夹"
                                    IsOn="{x:Bind Vm.OpenOutputFolderWhenDone, Mode=TwoWay}" />
                            </StackPanel>

                            <!--  格式  -->
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="输出格式" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="CmbFormat"
                                    AutomationProperties.Name="输出格式"
                                    SelectedIndex="{x:Bind Vm.FormatIndex, Mode=TwoWay}">
                                    <x:String>PNG</x:String>
                                    <x:String>JPEG</x:String>
                                    <x:String>WebP</x:String>
                                </ComboBox>

                                <Grid ColumnSpacing="8" Visibility="{x:Bind helpers:Ui.Visible(Vm.ShowQuality)}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="质量" />
                                    <Slider
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="SliderQuality"
                                        AutomationProperties.Name="输出质量"
                                        Maximum="100"
                                        Minimum="1"
                                        StepFrequency="1"
                                        Value="{x:Bind Vm.Quality, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        MinWidth="24"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{x:Bind Vm.QualityLabel}"
                                        TextAlignment="Right" />
                                </Grid>

                                <ToggleSwitch
                                    AutomationProperties.AutomationId="TogglePreserveAlpha"
                                    AutomationProperties.Name="保留透明通道"
                                    Header="保留透明通道"
                                    IsEnabled="{x:Bind Vm.PreserveAlphaEnabled}"
                                    IsOn="{x:Bind Vm.PreserveAlpha, Mode=TwoWay}" />
                            </StackPanel>

                            <!--  高级  -->
                            <Expander
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="ExpanderAdvanced"
                                Header="高级">
                                <StackPanel Padding="0,6,0,0" Spacing="8">
                                    <ToggleSwitch
                                        AutomationProperties.AutomationId="ToggleShowGeneralModels"
                                        AutomationProperties.Name="显示通用模型"
                                        Header="显示通用模型"
                                        IsOn="{x:Bind Vm.ShowGeneralModels, Mode=TwoWay}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="CPU 线程数" />
                                        <NumberBox
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="NumCpuThreads"
                                            AutomationProperties.Name="CPU 线程数"
                                            Maximum="256"
                                            Minimum="0"
                                            SpinButtonPlacementMode="Compact"
                                            ToolTipService.ToolTip="CPU 推理线程数，0 = 自动"
                                            Value="{x:Bind Vm.CpuThreads, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox
                                            Grid.Column="0"
                                            AutomationProperties.AutomationId="NumTileSize"
                                            AutomationProperties.Name="分块大小"
                                            Header="分块大小"
                                            Maximum="4096"
                                            Minimum="0"
                                            SpinButtonPlacementMode="Compact"
                                            ToolTipService.ToolTip="输入块边长，0 = 自动"
                                            Value="{x:Bind Vm.TileSize, Mode=TwoWay}" />
                                        <NumberBox
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="NumTilePad"
                                            AutomationProperties.Name="分块边距"
                                            Header="分块边距"
                                            Maximum="1024"
                                            Minimum="0"
                                            SpinButtonPlacementMode="Compact"
                                            ToolTipService.ToolTip="输入块重叠边距，0 = 自动"
                                            Value="{x:Bind Vm.TilePadding, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  面板底部固定信息区  -->
                    <Border
                        Grid.Row="2"
                        Padding="16,10"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <StackPanel Spacing="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="输入" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="12"
                                    Text="{x:Bind Vm.InputSizeText}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="输出预估" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="12"
                                    Text="{x:Bind Vm.OutputSizeText}"
                                    Visibility="{x:Bind helpers:Ui.OutputSizeNormal(Vm.OutputSizeExceeded, Vm.OutputSizeWarning)}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Text="{x:Bind Vm.OutputSizeText}"
                                    Visibility="{x:Bind helpers:Ui.Visible(Vm.OutputSizeWarning)}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind Vm.OutputSizeText}"
                                    Visibility="{x:Bind helpers:Ui.Visible(Vm.OutputSizeExceeded)}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="模型大小" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="12"
                                    Text="{x:Bind Vm.ModelSizeText}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  折叠态：只留一条图标栏  -->
                <Button
                    Width="32"
                    Height="32"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="BtnExpandPanel"
                    AutomationProperties.Name="展开参数面板"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind Vm.TogglePanelCommand}"
                    ToolTipService.ToolTip="展开参数面板"
                    Visibility="{x:Bind helpers:Ui.VisibleWhenFalse(Vm.IsPanelExpanded)}">
                    <FontIcon FontSize="12" Glyph="&#xE76B;" />
                </Button>
            </Grid>
        </Grid>

        <!--  ═══════════════ 底部状态条（32 DIP）  ═══════════════  -->
        <Grid
            Grid.Row="2"
            Padding="16,0"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    AutomationProperties.AutomationId="TxtBackend"
                    FontSize="12"
                    Text="{x:Bind Vm.BackendName}" />
                <TextBlock
                    MaxWidth="280"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Vm.DeviceName}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressBar
                    Width="140"
                    Maximum="100"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ProgressBarStatus"
                    AutomationProperties.Name="整体进度"
                    Value="{x:Bind Vm.ProgressValue}"
                    Visibility="{x:Bind helpers:Ui.Visible(Vm.IsProcessing)}" />
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="TxtStatus"
                    FontSize="12"
                    MaxWidth="140"
                    Text="{x:Bind Vm.StatusText}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="TxtStatusDetail"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxWidth="280"
                    Text="{x:Bind Vm.StatusDetail}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    MinHeight="22"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="BtnCancel"
                    AutomationProperties.Name="取消处理"
                    Command="{x:Bind Vm.CancelCommand}"
                    Content="取消"
                    FontSize="12"
                    Visibility="{x:Bind helpers:Ui.Visible(Vm.IsProcessing)}" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    AutomationProperties.AutomationId="TxtDimensions"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Vm.DimensionsText}" />
            </StackPanel>
        </Grid>

        <!--  拖放高亮：2px 强调色边框  -->
        <Border
            x:Name="DropHighlight"
            Grid.RowSpan="3"
            Margin="1"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="2"
            CornerRadius="8"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
